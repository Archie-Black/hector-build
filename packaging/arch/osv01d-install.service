[Unit]
Description=OS V01D install. No loader. Hector asks.
After=osv01d-firmware.service graphical.target
[Service]
Type=simple
Environment=V01D_INSTALL=1
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
ExecStart=/usr/share/osv01d/packaging/arch/live-boot.sh
Restart=on-failure
[Install]
WantedBy=graphical.target
