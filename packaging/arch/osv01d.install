post_install() {
  echo "OS V01D $1"
  echo "pacman owns this tree. Dual-core + diplomat hear."
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable osv01d-cores.service >/dev/null 2>&1 || true
  systemctl enable osv01d-firmware.timer >/dev/null 2>&1 || true
  echo "User session: systemctl --user enable --now osv01d-hear.service"
  echo "PipeWire node: osv01d.diplomat.hear"
  echo "Verify: osv01d-verify"
  chmod +x /usr/share/osv01d/packaging/cloud/*.sh 2>/dev/null || true
  HECTOR_PREFIX=/usr/share/osv01d bash /usr/share/osv01d/packaging/linux/install-os-games.sh /usr/share/osv01d || true
}

post_upgrade() {
  post_install "$1"
}

post_remove() {
  systemctl disable --now osv01d-cores.service >/dev/null 2>&1 || true
  systemctl disable --now osv01d-firmware.timer >/dev/null 2>&1 || true
}
