# Maintainer: DeltaKingZero <Deltakingzero@doomchat.ca>
pkgname=osv01d
pkgver=0.1.0
pkgrel=1
pkgdesc="OS V01D. Hector Build. Spectral HX. Wayland desktop."
arch=('x86_64')
url="https://www.doomchat.ca"
license=('custom')
depends=('hyprland' 'wayland' 'nodejs' 'npm' 'pipewire' 'samba' 'mesa')
source=()
md5sums=()

package() {
  prefix="$pkgdir/usr/share/osv01d"
  install -d "$prefix" "$pkgdir/usr/bin" "$pkgdir/usr/share/wayland-sessions" "$pkgdir/usr/share/applications"
  cp -a "$startdir/../.."/. "$prefix"/ || true
  install -Dm755 "$startdir/../linux/osv01d.sh" "$pkgdir/usr/bin/osv01d"
  install -Dm644 "$startdir/../linux/osv01d.desktop" "$pkgdir/usr/share/applications/osv01d.desktop"
  install -Dm644 "$startdir/../../native/v01d/wayland/osv01d.desktop" "$pkgdir/usr/share/wayland-sessions/osv01d.desktop"
}
