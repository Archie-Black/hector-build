# Hector Build · doomchat.ca
# One VPS. Caddy terminates TLS.
#
# DNS: packaging/host/dns/doomchat.ca.zone  +  dns/apply.sh
# Wildcard A * and *.build → this box. User sites: slug.build.doomchat.ca
#
# Local services:
#   127.0.0.1:8080  Hector Build + Spectral HX
#   127.0.0.1:4000  y.doomchat.ca social
#   127.0.0.1:8090  file share
#   127.0.0.1:6167  Matrix (conduwuit)

{
	email admin@doomchat.ca
	on_demand_tls {
		ask http://127.0.0.1:8080/api/v1/host/ask
		interval 2m
		burst 10
	}
}

(proxy) {
	header_up Host {host}
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Proto {scheme}
	header_up X-Real-IP {remote_host}
	header_up Upgrade {http.request.header.Upgrade}
	header_up Connection {http.request.header.Connection}
	flush_interval -1
	transport http {
		read_timeout 0
		write_timeout 0
		versions 1.1 2
	}
}

(isolate) {
	header -Set-Cookie
	header Cross-Origin-Opener-Policy same-origin
	header Cross-Origin-Embedder-Policy credentialless
	header Cross-Origin-Resource-Policy same-origin
	header Origin-Agent-Cluster "?1"
	header X-Content-Type-Options nosniff
	header X-Frame-Options DENY
	header Referrer-Policy no-referrer
	header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	header Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
	header Cache-Control no-store
}

doomchat.ca {
	redir https://www.doomchat.ca{uri} permanent
	header Strict-Transport-Security "max-age=15552000; includeSubDomains"
}

www.doomchat.ca {
	encode gzip zstd
	header Strict-Transport-Security "max-age=15552000; includeSubDomains"
	reverse_proxy 127.0.0.1:8080 {
		import proxy
	}
}

hx.doomchat.ca {
	encode gzip zstd
	@root path /
	redir @root /hx
	reverse_proxy 127.0.0.1:8080 {
		import proxy
	}
}

y.doomchat.ca {
	encode gzip zstd
	reverse_proxy 127.0.0.1:4000 {
		import proxy
	}
}

files.doomchat.ca {
	encode gzip zstd
	@share {
		not path /healthz
	}
	reverse_proxy @share 127.0.0.1:8090 {
		import proxy
		fail_duration 10s
		max_fails 2
		lb_try_duration 2s
	}
	handle_errors {
		root * /var/lib/hector/share
		file_server browse
	}
}

updates.doomchat.ca {
	encode gzip
	rewrite * /updates.json
	reverse_proxy 127.0.0.1:8080 {
		import proxy
	}
	header Access-Control-Allow-Origin *
	header Cache-Control "public, max-age=60"
}

chat.doomchat.ca {
	encode gzip zstd
	handle /_matrix/* {
		reverse_proxy 127.0.0.1:6167 {
			import proxy
		}
	}
	handle {
		root * /var/lib/hector/element
		try_files {path} /index.html
		file_server
	}
}

matrix.doomchat.ca {
	encode gzip zstd
	reverse_proxy 127.0.0.1:6167 {
		import proxy
	}
}

# Isolation zone. Cookie jar cannot reach www / hx / y.
*.build.doomchat.ca {
	encode gzip zstd
	tls {
		on_demand
	}
	import isolate
	handle {
		rewrite * /api/v1/host/publish?slug={labels.3}&path={path}&k={query.k}
		reverse_proxy 127.0.0.1:8080 {
			import proxy
		}
	}
}

build.doomchat.ca {
	redir https://www.doomchat.ca{uri} permanent
}

# First-level names that are not services do not host user builds.
*.doomchat.ca {
	respond "Not a Hector host" 421
}
