{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Typecheck",
      "type": "shell",
      "command": "npx tsc --noEmit",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$tsc",
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "npx vitest run",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Doctor",
      "type": "shell",
      "command": "bash packaging/linux/doctor.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "ISO profile",
      "type": "shell",
      "command": "bash packaging/arch/mkiso.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent", "panel": "shared" }
    }
  ]
}
